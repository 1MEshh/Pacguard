[Unit]
Description=Hardened Background Telemetry Worker
After=network.target

[Service]
Type=exec
ExecStart=/usr/bin/telemetry-worker --daemon
Restart=on-failure

# 24 Security Directives - Maximum Hardening
DynamicUser=yes
User=telemetry
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
MemoryDenyWriteExecute=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
